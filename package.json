{
  "name": "playcanvas-agent-bridge-cli",
  "version": "0.6.1",
  "description": "CLI-first local bridge for automating open PlayCanvas Editor tabs from AI coding agents.",
  "type": "module",
  "license": "MIT",
  "author": "Q-My99",
  "homepage": "https://github.com/Q-My99/playcanvas-agent-bridge-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Q-My99/playcanvas-agent-bridge-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Q-My99/playcanvas-agent-bridge-cli/issues"
  },
  "bin": {
    "pcbridge": "dist/cli.js"
  },
  "files": [
    "dist",
    "extension",
    "skills",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && bun -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:version": "bun scripts/check-version.mjs",
    "test": "bun run check:version && bun run build && bun test --timeout 30000 --isolate ./test",
    "prepack": "bun run build"
  },
  "keywords": [
    "playcanvas",
    "cli",
    "chrome-extension",
    "automation",
    "agent"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1102.0",
    "@babel/core": "7.28.4",
    "@babel/preset-env": "7.28.3",
    "dotenv": "17.4.2",
    "tar": "7.5.22",
    "terser": "5.50.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/babel__core": "7.20.5",
    "@types/babel__preset-env": "7.10.0",
    "@types/node": "24.13.2",
    "@types/ws": "8.18.1",
    "typescript": "5.8.3"
  },
  "packageManager": "bun@1.4.0"
}
